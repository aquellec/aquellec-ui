{
  "name": "@aquellec/ui",
  "version": "0.1.0",
  "description": "Composants UI React pour applications SaaS de recrutement (analyse de CV, matching ATS).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsup && node --experimental-strip-types --no-warnings scripts/generate-theme-css.mjs && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test:storybook": "vitest run --project storybook",
    "playwright:install": "playwright install chromium",
    "check:tailwind-v4": "node scripts/check-tailwind-v4.mjs"
  },
  "keywords": [
    "react",
    "design-system",
    "tailwind",
    "storybook",
    "typescript"
  ],
  "author": "Amandine Quellec",
  "license": "MIT",
  "homepage": "https://27473af902f42be3efeb0973435f662f.share.chromatic.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aquellec/aquellec-ui.git"
  },
  "bugs": {
    "url": "https://github.com/aquellec/aquellec-ui/issues"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.31.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.5.4",
    "lucide-react": "^1.35.0",
    "playwright": "1.62.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  }
}
